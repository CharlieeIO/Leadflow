# ─────────────────────────────────────────────────────────────
# LeadFlow — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
# The public URL of this deployment (no trailing slash)
# Local: http://localhost:3000  |  Prod: https://app.yourleadflow.com
NEXT_PUBLIC_APP_URL=

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://zwggbfrpznlekwmqvxgu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp3Z2diZnJwem5sZWt3bXF2eGd1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg1MjUxMzQsImV4cCI6MjA5NDEwMTEzNH0.pstu7plMwLKWTqP2dOOdAenb9XA20npKb1eKo5fAfG8
# Service role key — server-side only, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp3Z2diZnJwem5sZWt3bXF2eGd1Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3ODUyNTEzNCwiZXhwIjoyMDk0MTAxMTM0fQ.UuXd18ZvXseX0VT3UxR8h1t-ndCgRCXlCLO4UNewhuw

# ── Anthropic (Claude AI) ────────────────────────────────────
# Found in: console.anthropic.com → API Keys
# Used for SMS qualification, chat widget, and voice prompt generation
ANTHROPIC_API_KEY=

# ── Twilio ───────────────────────────────────────────────────
# Found in: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A secret string you set when configuring Twilio webhooks for signature validation
# Set this same value in your Twilio webhook URL: ?secret=YOUR_VALUE
TWILIO_WEBHOOK_SECRET=

# ── Retell AI (Voice Agent) ──────────────────────────────────
# Found in: app.retellai.com → API Keys
RETELL_API_KEY=

# ── Cal.com (Booking) ─────────────────────────────────────────
# Found in: app.cal.com → Settings → Developer → API Keys
CAL_API_KEY=
# Webhook secret set in Cal.com → Settings → Webhooks
CAL_WEBHOOK_SECRET=

# ── Stripe (Billing) ─────────────────────────────────────────
# Found in: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Found in: dashboard.stripe.com → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe product catalog
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ── Resend (Transactional Email) ─────────────────────────────
# Found in: resend.com → API Keys
RESEND_API_KEY=
# Verified sender domain/address in Resend (e.g. alerts@mail.yourleadflow.com)
RESEND_FROM_EMAIL=

# ── Axiom (Structured Logging) ───────────────────────────────
# Found in: app.axiom.co → Settings → API Tokens
# AXIOM_DATASET: the dataset name where logs are written
AXIOM_DATASET=
AXIOM_TOKEN=

# ── Sentry (Error Tracking) ──────────────────────────────────
# Found in: sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=

# ── Internal Security ────────────────────────────────────────
# A long random secret used to protect cron job routes from unauthorized calls
# Generate with: openssl rand -base64 32
# Set as Authorization header: Bearer YOUR_ADMIN_SECRET
ADMIN_SECRET=

# Your email address — gates access to /admin routes and the Admin Panel link
ADMIN_EMAIL=
