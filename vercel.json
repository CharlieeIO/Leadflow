{
  "functions": {
    "app/api/webhooks/sms/route.ts":        { "maxDuration": 30 },
    "app/api/webhooks/voice/route.ts":      { "maxDuration": 30 },
    "app/api/webhooks/retell/route.ts":     { "maxDuration": 30 },
    "app/api/chat/route.ts":                { "maxDuration": 30 },
    "app/api/cron/sequences/route.ts":      { "maxDuration": 300 },
    "app/api/cron/reminders/route.ts":      { "maxDuration": 60 },
    "app/api/cron/no-shows/route.ts":       { "maxDuration": 60 },
    "app/api/cron/weekly-report/route.ts":  { "maxDuration": 60 },
    "app/api/admin/businesses/route.ts":    { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/sequences",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/no-shows",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 8 * * 1"
    }
  ]
}
